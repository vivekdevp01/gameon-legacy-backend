# Copy to backend/.env for local development.
# On Railway, set these under Service -> Variables instead (no .env file there).

# Local MongoDB service:
MONGO_URL="mongodb://localhost:27017"
# MongoDB Atlas (hosted) looks like:
# MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

DB_NAME="legacy_pos"

# Comma-separated browser origins allowed to call this API.
# Local:  http://localhost:3000
# Prod:   https://your-app.vercel.app
CORS_ORIGINS="http://localhost:3000"
# Set to 0 for unlimited local browser uploads. Hosted deployments should use
# a finite value because the platform may impose its own request-size limit.
MAX_UPLOAD_MB=0
